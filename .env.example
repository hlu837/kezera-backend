# Server
PORT=3000

# MongoDB connection string. Must point at a replica set: Mongoose
# transactions (services/auth.service.js) require one even in local dev.
# Easiest local setup: `mongod --replSet rs0` then, once, `mongosh --eval "rs.initiate()"`.
MONGODB_URI=mongodb://localhost:27017/keferajobs?replicaSet=rs0

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_ISSUER=keferajobs-api

# bcrypt
BCRYPT_SALT_ROUNDS=12

# AWS S3 / S3-compatible storage (required)
AWS_REGION=us-east-1
AWS_S3_BUCKET=keferajobs-uploads
AWS_ACCESS_KEY_ID=replace-with-access-key
AWS_SECRET_ACCESS_KEY=replace-with-secret-key

# Optional: only set these when using a non-AWS S3-compatible provider
# (MinIO, DigitalOcean Spaces, Cloudflare R2, etc.)
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false

# Optional: CDN or custom domain fronting the bucket. If unset, URLs are
# built as a standard virtual-hosted-style S3 URL.
AWS_S3_PUBLIC_BASE_URL=

# Upload limits
MAX_UPLOAD_SIZE_MB=5

# Redis (matching queue — required by src/matching-worker.js and by
# anything that enqueues JOB_MATCHING tasks, e.g. job creation)
REDIS_URL=redis://localhost:6379

# Matching engine
MATCHING_DEFAULT_TOP_N=20
MATCHING_WORKER_CONCURRENCY=5

# Notifications worker (src/notifications-worker.js)
NOTIFICATIONS_WORKER_CONCURRENCY=5

# SMS — choose one provider via SMS_PROVIDER: "twilio" | "africastalking"
SMS_PROVIDER=twilio

# Twilio (used when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_FROM_NUMBER=+15551234567

# Africa's Talking (used when SMS_PROVIDER=africastalking)
AT_API_KEY=replace-with-africas-talking-api-key
AT_USERNAME=replace-with-africas-talking-username
AT_SENDER_ID=
# Shared secret embedded in the inbound webhook URL registered on the
# AT dashboard (.../sms/receive?provider=africastalking&secret=...),
# since AT does not cryptographically sign inbound callbacks.
AT_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Exact public origin this app is reachable at — required to verify
# Twilio's inbound webhook signature (X-Twilio-Signature is computed
# over the exact URL Twilio was configured to call).
PUBLIC_BASE_URL=https://api.keferajobs.com

# SendGrid (email)
SENDGRID_API_KEY=replace-with-sendgrid-api-key
NOTIFICATIONS_FROM_EMAIL=notifications@keferajobs.com
NOTIFICATIONS_FROM_NAME=KeferaJobs

# Chapa (payments — src/services/chapa.service.js). Falls back to a
# simulated/placeholder mode (no real charges) if left unset, so this is
# optional for local dev but required for real payments in production.
CHAPA_SECRET_KEY=replace-with-chapa-secret-key
CHAPA_BASE_URL=https://api.chapa.co/v1

# Anthropic (AI-assisted applicant summaries — src/services/ai.service.js).
# Optional: if unset, GET /jobs/:id/applications/summary still returns
# the structured stats (experience/skills/city breakdown), just with
# aiAvailable: false and no per-candidate AI summary.
ANTHROPIC_API_KEY=replace-with-anthropic-api-key

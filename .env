# ─────────────────────────────────────────────────────────────────
# NOTE: This file is for LOCAL DEVELOPMENT only. Vercel does NOT read
# .env at runtime — it's git-ignored and never gets deployed. For
# production, copy these same key/value pairs into the Vercel
# dashboard under Settings → Environment Variables instead.
# ─────────────────────────────────────────────────────────────────

# Server
PORT=3000

# MongoDB
MONGODB_URI=mongodb+srv://hilinayared438_db_user:fOFCfRxgOrDTpreD@cluster0.p3vuxpu.mongodb.net/keferajobs?retryWrites=true&w=majority&appName=Cluster0

# JWT
JWT_SECRET=dev-jwt-secret-key-keferajobs-2026-secure
JWT_EXPIRES_IN=7d
JWT_ISSUER=keferajobs-api

# bcrypt
BCRYPT_SALT_ROUNDS=10

# AWS S3 / S3-compatible storage — pointed at Supabase Storage's
# S3-compatible endpoint (see supabase.com/dashboard/project/<ref>/storage/s3)
AWS_REGION=eu-west-1
AWS_S3_BUCKET=kezerajobs-uploads
AWS_ACCESS_KEY_ID=502c448fffe3ca493d7b09aef3935e59
AWS_SECRET_ACCESS_KEY=92b8261030b99d3e59e207cbafd163a6a8e077b7d028999f
AWS_S3_ENDPOINT=https://imzwytvvqqtpsnfmqjim.storage.supabase.co/storage/v1/s3
AWS_S3_FORCE_PATH_STYLE=true
AWS_S3_PUBLIC_BASE_URL=https://imzwytvvqqtpsnfmqjim.supabase.co/storage/v1/object/public/kezerajobs-uploads

# Upload limits
MAX_UPLOAD_SIZE_MB=5

# Redis (matching queue — required by src/matching-worker.js and by
# anything that enqueues JOB_MATCHING tasks, e.g. job creation).
# NOT SET — matching/notifications workers won't run without this.
# A free option: Upstash (redis.upstash.com), no card required.
REDIS_URL=redis://localhost:6379

# Matching engine
MATCHING_DEFAULT_TOP_N=20
MATCHING_WORKER_CONCURRENCY=5

# Notifications worker
NOTIFICATIONS_WORKER_CONCURRENCY=5

# SMS — NOT CONFIGURED. Set SMS_PROVIDER + the matching block below if
# you want SMS job alerts working; otherwise leave as-is, the app runs
# fine without SMS.
SMS_PROVIDER=twilio

# Twilio (used when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_FROM_NUMBER=+15551234567

# Africa's Talking (used when SMS_PROVIDER=africastalking)
AT_API_KEY=replace-with-africas-talking-api-key
AT_USERNAME=replace-with-africas-talking-username
AT_SENDER_ID=
AT_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Exact public origin this app is reachable at (needed to verify
# Twilio's inbound webhook signature). Update once you have your
# real Vercel URL, e.g. https://kezerajobs-api.vercel.app
PUBLIC_BASE_URL=https://api.keferajobs.com

# SendGrid (email) — NOT CONFIGURED
SENDGRID_API_KEY=replace-with-sendgrid-api-key
NOTIFICATIONS_FROM_EMAIL=notifications@keferajobs.com
NOTIFICATIONS_FROM_NAME=KeferaJobs

